# MCU 与 bootloader 配置
MCU = RP2040
BOOTLOADER = rp2040

# 编译优化
OPT_DEFS += -DINTERRUPT_CONTROL_ENDPOINT

# 基础功能开关
BOOTMAGIC_ENABLE = yes
MOUSEKEY_ENABLE = yes
EXTRAKEY_ENABLE = yes
CONSOLE_ENABLE = no
COMMAND_ENABLE = no
NKRO_ENABLE = yes

# 外设驱动（按需开启/关闭）
WS2812_DRIVER = vendor
RGB_MATRIX_DRIVER = WS2812
